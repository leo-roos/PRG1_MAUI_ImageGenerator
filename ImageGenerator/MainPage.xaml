<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImageGenerator.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Image gallery"
                FontSize="26"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Image
                x:Name="ShowGallery"
                HeightRequest="240"
                Aspect="AspectFit"
                SemanticProperties.Description="a randomm image from a gallery" />

            <Label
                x:Name="ImageText"
                Style="{StaticResource Headline}" />

            <Entry x:Name="CommentEntry" Placeholder="Comment" MaximumWidthRequest="300" TextChanged="Comment_TextChanged" />

            <ImageButton x:Name="FavoriteButton"
                     WidthRequest="40"
                     HeightRequest="40"
                     BackgroundColor="Transparent"
                     Clicked="OnFavoriteClicked"
                     SemanticProperties.Hint="a heart to highlight a favorite image">
                <ImageButton.Source>

                    <FontImageSource Glyph="&#xE87E;"
                                 FontFamily="MaterialIcons"
                                 Size="32"
                                 Color="Gray"/>
                </ImageButton.Source>
            </ImageButton>

            <Grid VerticalOptions="Fill" ColumnSpacing="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" />
                    <ColumnDefinition Width="75*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="LastImageButton"
                    Grid.Column="0"
                    Text="Visa senaste bild" 
                    SemanticProperties.Hint="shows the last image"
                    Clicked="LastImageOnClicked" />

                <Button
                    Grid.Column="1"
                    Text="Visa ny bild" 
                    SemanticProperties.Hint="shows a new image when you click"
                    Clicked="ImageOnClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
